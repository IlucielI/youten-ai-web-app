# Application Configuration
APP_NAME=code-base-nextjs
APP_ENV=development
APP_VERSION=0.1.0
GIT_HASH=dev
PORT=3000

# Backend / Core API (if applicable)
CORE_API_URL=http://localhost:8080
MOCK_CORE_API=true
USE_MOCK_DATA=true

# Client Credentials for anonymous handshake
CLIENT_APP_ID=client-app
CLIENT_APP_SECRET=secret

# Next.js Telemetry
NEXT_TELEMETRY_DISABLED=1
